<html>
<head>
<title>RoyalHub Standalone</title>
<HTA:APPLICATION
    APPLICATIONNAME="RoyalHub Standalone Launcher"
    ID="RoyalHubLauncher"
    BORDER="thin"
    CAPTION="yes"
    SHOWINTASKBAR="yes"
    SINGLEINSTANCE="yes"
    SYSMENU="yes"
    SCROLL="no"
    MAXIMIZEBUTTON="no"
    MINIMIZEBUTTON="yes"
/>
<style>
  /* Palette: navy/blue "Trust & Authority" enterprise system. Segoe UI stays
     the font because this window has to render correctly with zero internet
     access (the whole point of the offline badge is that the app still
     works with no connection). Colors are written as literal hex values
     everywhere, not CSS custom properties (--vars) - this window renders
     through Internet Explorer's engine (mshta.exe), which never supported
     custom properties in any version, so var(--x) silently resolves to
     nothing and every rule that used one loses its styling entirely. Layout
     uses float/inline-block, not flexbox's "gap" property, for the same
     reason - IE11 never added gap support for flex containers. */
  * { box-sizing: border-box; }
  body { font-family: "Segoe UI", Arial, sans-serif; background: #F8FAFC; color: #0F172A; margin: 0; padding: 20px 22px; }
  .clearfix:after { content: ""; display: block; clear: both; }

  .topbar { margin-bottom: 14px; }
  .brand-mark { display: inline-block; width: 26px; height: 26px; border-radius: 7px; background: #1E3A5F; color: #fff; font-size: 11px; font-weight: 700; text-align: center; line-height: 26px; vertical-align: middle; }
  .brand-name { display: inline-block; vertical-align: middle; margin-left: 9px; font-size: 15px; font-weight: 600; color: #1E3A5F; }
  .conn-badge { float: right; margin-top: 4px; font-size: 11px; color: #5B6472; padding: 4px 9px; border-radius: 999px; background: #F1F3F5; border: 1px solid #E4E7EB; }
  .conn-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: #5B6472; margin-right: 6px; }
  .conn-dot.online { background: #059669; }
  .conn-dot.offline { background: #5B6472; }

  p.lead { font-size: 12.5px; color: #5B6472; margin: 0 0 14px; line-height: 1.5; clear: both; }

  .card { background: #FFFFFF; border: 1px solid #E4E7EB; border-radius: 10px; padding: 4px 14px; margin-bottom: 10px; clear: both; }
  .status-row { padding: 10px 0; }
  .status-row.bordered { border-top: 1px solid #E4E7EB; }
  .status-icon { float: left; width: 22px; height: 22px; border-radius: 50%; text-align: center; line-height: 22px; font-size: 12px; font-weight: 700; background: #F1F3F5; color: #5B6472; }
  .status-icon.good { background: #D1FAE5; color: #059669; }
  .status-icon.bad { background: #FEE2E2; color: #DC2626; }
  .status-text { margin-left: 32px; display: block; font-size: 12.5px; line-height: 1.45; }
  .status-text .label { font-weight: 600; color: #0F172A; }
  .status-text .detail { color: #5B6472; }
  .status-text a { color: #2563EB; cursor: pointer; text-decoration: underline; }

  .actions-primary { margin: 14px 0 8px; clear: both; }
  .btn { font-family: inherit; font-size: 14px; font-weight: 600; padding: 11px 20px; border: none; border-radius: 7px; cursor: pointer; }
  .btn:disabled { cursor: default; background: #9aa5b8 !important; color: #fff; }
  .btn-block { display: block; width: 100%; }
  .btn-primary { background: #1E3A5F; color: #fff; }
  .btn-primary:hover { background: #15293F; }
  .btn-danger { background: #DC2626; color: #fff; }
  .btn-danger:hover { background: #B91C1C; }
  .btn-ghost { background: #F1F3F5; color: #1E3A5F; font-size: 12.5px; padding: 9px 20px; margin-top: 8px; }
  .btn-ghost:hover { background: #E4E7EB; }

  .divider { height: 1px; background: #E4E7EB; margin: 14px 0 12px; clear: both; }

  .actions-secondary { clear: both; }
  .btn-outline { float: left; width: 48%; background: #fff; color: #5B6472; font-size: 12px; padding: 8px 10px; border: 1px solid #E4E7EB; }
  .btn-outline:hover { background: #F1F3F5; color: #0F172A; }
  .btn-outline.right { float: right; }
  .btn-outline:disabled { background: #F1F3F5 !important; color: #9aa5b8 !important; }

  #status { margin-top: 12px; font-size: 11.5px; color: #5B6472; min-height: 15px; text-align: center; clear: both; }
</style>
<script language="JScript">
var isRunning = false;
var isChecking = false;
var requirementsOk = false;
var MIN_NODE_VERSION = "22.13.0";

// This .hta's own folder \u2014 document.location.pathname gives something like
// "/C:/Users/.../RoyalHub_Standalone/launch-windows.hta" (URL-encoded, leading slash).
function GetScriptDir() {
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    var scriptPath = unescape(document.location.pathname);
    if (scriptPath.charAt(0) === "/") scriptPath = scriptPath.substring(1);
    scriptPath = scriptPath.replace(/\//g, "\\");
    return fso.GetParentFolderName(scriptPath);
}

// Backup/restore never need Node.js at all (just zip/unzip), so they stay
// enabled based purely on "is the app currently running" \u2014 only Run itself
// additionally needs requirementsOk (see CheckRequirements below).
function SetIdleButtons(enabled) {
    document.getElementById("runBtn").disabled = !(enabled && requirementsOk);
    document.getElementById("backupBtn").disabled = !enabled;
    document.getElementById("restoreBtn").disabled = !enabled;
}

// Sets an icon-circle + label/detail status row in one place, rather than
// repeating this innerHTML pattern at every call site.
function SetStatusRow(prefix, tone, glyph, label, detailHtml) {
    var icon = document.getElementById("icon-" + prefix);
    var text = document.getElementById("text-" + prefix);
    icon.className = "status-icon" + (tone ? " " + tone : "");
    icon.innerHTML = glyph;
    text.innerHTML = '<span class="label">' + label + '</span> <span class="detail">' + detailHtml + '</span>';
}

// The small "Online"/"Offline" badge in the top-right corner \u2014 reflects
// whether the last update check actually reached the internet, independent
// of whether a patch was needed. Deliberately neutral-grey when offline
// (not red): working offline is a normal, supported way to use this app,
// not an error state.
function SetConnectionBadge(online) {
    var dot = document.getElementById("connDot");
    var text = document.getElementById("connText");
    dot.className = "conn-dot " + (online ? "online" : "offline");
    text.innerText = online ? "Online" : "Offline";
}

function ParseVersion(v) {
    var parts = v.split(".");
    return [parseInt(parts[0], 10) || 0, parseInt(parts[1], 10) || 0, parseInt(parts[2], 10) || 0];
}

function VersionAtLeast(version, minVersion) {
    var v = ParseVersion(version), m = ParseVersion(minVersion);
    for (var i = 0; i < 3; i++) {
        if (v[i] > m[i]) return true;
        if (v[i] < m[i]) return false;
    }
    return true;
}

// Runs a command with NO visible window at all, by redirecting its output
// to a temp file and reading that back afterward - unlike shell.Exec(),
// which always opens a real console window with no way to hide it (Exec
// has no windowStyle parameter; only Run does). That window was flashing
// open and closed on every check, and each flash could steal and return
// this window's focus, re-triggering Window_OnFocus mid-check and causing
// a visible flicker loop with overlapping, conflicting checks underneath.
function RunHidden(shell, fso, cmd) {
    var tempPath = fso.GetSpecialFolder(2) + "\\rh_" + new Date().getTime() + "_" + Math.floor(Math.random() * 1000000) + ".tmp";
    var exitCode = shell.Run('cmd /c ' + cmd + ' > "' + tempPath + '" 2>&1', 0, true);
    var output = "";
    if (fso.FileExists(tempPath)) {
        var file = fso.OpenTextFile(tempPath, 1);
        output = file.ReadAll();
        file.Close();
        try { fso.DeleteFile(tempPath, true); } catch (e) {}
    }
    return { output: output, exitCode: exitCode };
}

function GetNodeVersion(shell, fso) {
    try {
        var r = RunHidden(shell, fso, "node -v");
        if (r.exitCode !== 0 || !r.output) return null;
        return r.output.replace(/^v/, "").replace(/\s+$/, "");
    } catch (e) { return null; }
}

function OpenNodeDownload() {
    var shell = new ActiveXObject("WScript.Shell");
    shell.Run("https://nodejs.org", 1, false);
}

// For re-opening the app after accidentally closing its browser tab \u2014 the
// app is still running (this just points a browser at it again), so this
// stays enabled the whole time the app is running, same as Stop.
function OpenInBrowser() {
    var shell = new ActiveXObject("WScript.Shell");
    shell.Run("http://localhost:3000", 1, false);
}

// Reads version.json directly (separate from the patcher's own one-line
// result) just to get the human-readable "updated" date for display \u2014
// the patcher's output only needs to carry version numbers.
function ReadLocalVersionInfo(scriptDir, fso) {
    var path = scriptDir + "\\version.json";
    if (!fso.FileExists(path)) return null;
    try {
        var file = fso.OpenTextFile(path, 1);
        var text = file.ReadAll();
        file.Close();
        return JSON.parse(text);
    } catch (e) { return null; }
}

// Runs scripts\patch.ps1 synchronously (see that file) and returns its one
// line of output. It does the whole check-and-apply in one call: compares
// this copy's version.json against the public release repo (plain HTTPS,
// no GitHub login involved, works the same for a "git clone" or ZIP
// install), and if different, backs up data/ first and then patches \u2014
// so by the time this returns, the app is already current.
//
// Scans line by line rather than checking if the whole captured output
// starts with a known marker: PowerShell can print other things to the
// same stream first (a warning, a security notice) depending on this
// machine's settings, and a strict "starts with" check would silently
// fail to recognize a real result sitting a line or two further down. If
// truly nothing recognizable comes back, the raw output is saved to
// patch-debug.log for a real look instead of guessing again blind.
function RunPatcher(shell, fso, scriptDir) {
    var cmd = 'powershell -NoProfile -ExecutionPolicy Bypass -File "' + scriptDir + '\\scripts\\patch.ps1"';
    var r = RunHidden(shell, fso, cmd);
    var markers = ["PATCHED:", "UP_TO_DATE:", "CHECK_FAILED", "PATCH_FAILED:"];
    var lines = r.output.split(/\r?\n/);
    for (var i = 0; i < lines.length; i++) {
        var line = lines[i].replace(/\s+$/, "");
        for (var j = 0; j < markers.length; j++) {
            if (line.indexOf(markers[j]) === 0) return line;
        }
    }
    try {
        var log = fso.OpenTextFile(scriptDir + "\\patch-debug.log", 2, true);
        log.Write(r.output);
        log.Close();
    } catch (e) {}
    return "PATCH_FAILED:unrecognized output, see patch-debug.log";
}

// Checks what this computer actually needs before Run is allowed, and shows
// it plainly instead of letting someone click Run and only find out deep in
// a scrolling console window. Re-run automatically whenever this window
// regains focus (see Window_OnFocus), so installing Node.js and switching
// back here updates the checklist with no extra click needed.
//
// The version/update check never permanently blocks Run, even on failure or
// no internet \u2014 this app is supposed to keep working fully offline, so a
// failed update check should be visible, not a dead end.
function CheckRequirements() {
    // Guards against overlapping runs \u2014 e.g. if this window's focus state
    // flickers for any reason while a check (which can take several seconds:
    // it includes a real network call) is already in progress.
    if (isChecking) return;
    isChecking = true;

    var shell = new ActiveXObject("WScript.Shell");
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    var scriptDir = GetScriptDir();

    SetStatusRow("node", "", "\u2026", "Node.js", "Checking this computer\u2026");

    var nodeVersion = GetNodeVersion(shell, fso);
    if (!nodeVersion) {
        SetStatusRow("node", "bad", "\u2717", "Node.js", 'not found. <a href="javascript:OpenNodeDownload()">Click here to install it</a>, then come back.');
        requirementsOk = false;
    } else if (!VersionAtLeast(nodeVersion, MIN_NODE_VERSION)) {
        SetStatusRow("node", "bad", "\u2717", "Node.js", 'v' + nodeVersion + ' found, but it\'s too old (need v' + MIN_NODE_VERSION + '+). <a href="javascript:OpenNodeDownload()">Click here to update it</a>.');
        requirementsOk = false;
    } else {
        SetStatusRow("node", "good", "\u2713", "Node.js", 'v' + nodeVersion + ' \u2014 ready to run.');
        requirementsOk = true;
    }

    SetStatusRow("update", "", "\u2026", "Version", "Checking for updates\u2026");
    var patchResult = RunPatcher(shell, fso, scriptDir);
    var info = ReadLocalVersionInfo(scriptDir, fso);
    var versionText = info ? ("v" + info.version + " \u00b7 updated " + info.updatedAt.substring(0, 10)) : "unknown version";

    // CHECK_FAILED is the only outcome that means the version check itself
    // never reached the internet \u2014 every other outcome (even a failed
    // patch) implies the connection worked, so that's what drives the
    // Online/Offline badge.
    if (patchResult.indexOf("PATCHED:") === 0) {
        var parts = patchResult.split(":");
        SetStatusRow("update", "good", "\u2713", "Version", "Updated: v" + parts[1] + " \u2192 v" + parts[2] + ".");
        SetConnectionBadge(true);
    } else if (patchResult.indexOf("UP_TO_DATE:") === 0) {
        SetStatusRow("update", "good", "\u2713", "Version", "Up to date (" + versionText + ").");
        SetConnectionBadge(true);
    } else if (patchResult.indexOf("CHECK_FAILED") === 0) {
        SetStatusRow("update", "", "\u2139", "Version", "Can't check right now \u2014 using " + versionText + ".");
        SetConnectionBadge(false);
    } else if (patchResult.indexOf("PATCH_FAILED:") === 0) {
        SetStatusRow("update", "bad", "\u2717", "Version", "Update failed \u2014 using " + versionText + ". Contact IT support if this keeps happening.");
        SetConnectionBadge(true);
    } else {
        SetStatusRow("update", "", "\u2139", "Version", versionText);
        SetConnectionBadge(false);
    }

    SetIdleButtons(!isRunning);
    isChecking = false;
}

function RunApp() {
    var status = document.getElementById("status");
    SetIdleButtons(false);

    var shell = new ActiveXObject("WScript.Shell");
    var scriptDir = GetScriptDir();

    // Run is only clickable once the checklist above confirms Node.js is
    // present and the app has already been patched to the latest version
    // (see CheckRequirements) \u2014 no need to re-check either one here.
    status.innerText = "Starting...";

    // Run (not Exec) so npm install's and the dev server's own output renders
    // directly in a real, visible console window. Exec always redirects a
    // child's stdout/stderr to pipes back to this script instead of letting
    // it reach the screen \u2014 nothing is wrong with the app when that happens,
    // the window is just blank because its output is going somewhere this
    // script never reads, not to the console buffer at all. /k (not /c)
    // keeps that window open even if something in the chain fails, so an
    // error stays visible instead of the window just closing.
    // NODE_OPTIONS silences the one-time "SQLite is an experimental feature"
    // notice from Node's built-in node:sqlite (used for the local database) \u2014
    // harmless, but not worth it looking like something's wrong on first run.
    isRunning = true;
    shell.Run('cmd /k cd /d "' + scriptDir + '" && set NODE_OPTIONS=--disable-warning=ExperimentalWarning && powershell -NoProfile -ExecutionPolicy Bypass -File "scripts\\run-install-with-log.ps1" && npm run dev', 1, false);

    // Opens the browser once the server actually starts responding on port 3000 (npm install's
    // own time varies a lot run to run, so a fixed delay here would open too early or too late).
    shell.Run('powershell -NoProfile -WindowStyle Hidden -Command "for ($i=0; $i -lt 120; $i++) { try { (New-Object Net.Sockets.TcpClient(\'localhost\',3000)).Close(); Start-Process \'http://localhost:3000\'; break } catch { Start-Sleep -Milliseconds 1000 } }"', 0, false);

    status.innerText = "Starting \u2014 look for the new window. Click Stop below when you're done.";
    SetRunningUi(true);
}

// Swaps Run for Stop + Open in Browser (rather than just disabling them)
// so only the one button that's actually usable is ever visible. Uses
// style.display directly rather than the "hidden" attribute - this window
// renders through Internet Explorer's engine, and on a real machine the
// "hidden" attribute (and the [hidden] CSS rule meant to enforce it) did
// not reliably hide these buttons, which then pushed the rest of the
// window's content out of view entirely (SCROLL="no" means overflow is
// just clipped, not scrollable). style.display is the one technique with
// no HTML5/CSS3 ambiguity behind it at all.
function SetRunningUi(running) {
    document.getElementById("runBtn").style.display = running ? "none" : "";
    var stopBtn = document.getElementById("stopBtn");
    stopBtn.style.display = running ? "" : "none";
    stopBtn.disabled = !running;
    var openBtn = document.getElementById("openBtn");
    openBtn.style.display = running ? "" : "none";
    openBtn.disabled = !running;
}

function StopApp() {
    var status = document.getElementById("status");
    document.getElementById("stopBtn").disabled = true;
    document.getElementById("openBtn").disabled = true;
    status.innerText = "Stopping...";

    var shell = new ActiveXObject("WScript.Shell");

    // Kill whatever is actually listening on port 3000 \u2014 the launch window
    // is a plain visible console now (see RunApp), not something this script
    // holds a process handle to, so finding it by what it's doing (serving
    // port 3000) is more reliable than trying to track it by PID anyway.
    // Closing that console window by hand works too, same as the .bat/.command.
    try {
        shell.Run('cmd /c for /f "tokens=5" %a in (\'netstat -ano ^| findstr :3000 ^| findstr LISTENING\') do taskkill /PID %a /F', 0, true);
    } catch (e) {}
    isRunning = false;
    SetRunningUi(false);

    status.innerText = "Stopped. (If the console window is still open, you can also just close it.)";
    SetIdleButtons(true);
}

// Backup/restore shell out to the standalone .bat scripts rather than
// reimplementing their zip/unzip + dialog logic here \u2014 one tested copy of
// that logic, reachable either from this window or by double-clicking the
// .bat files directly. Disabled while the app is running (Run/Stop toggles
// these too): restoring over a database file the running server still has
// open is the one case worth just not allowing instead of explaining.
function BackupData() {
    var status = document.getElementById("status");
    SetIdleButtons(false);
    status.innerText = "Backing up \u2014 see the window/dialog that opened...";
    var shell = new ActiveXObject("WScript.Shell");
    shell.Run('cmd /c cd /d "' + GetScriptDir() + '" && call backup-data.bat', 1, true);
    status.innerText = "Backup finished.";
    SetIdleButtons(true);
}

function RestoreData() {
    var status = document.getElementById("status");
    SetIdleButtons(false);
    status.innerText = "Restoring \u2014 see the window/dialog that opened...";
    var shell = new ActiveXObject("WScript.Shell");
    shell.Run('cmd /c cd /d "' + GetScriptDir() + '" && call restore-data.bat', 1, true);
    status.innerText = "Restore finished.";
    SetIdleButtons(true);
}

function Window_OnLoad() {
    window.resizeTo(440, 430);
    CheckRequirements();
}

// Re-checks when this window regains focus \u2014 e.g. after installing Node.js
// from the link above and alt-tabbing back \u2014 so the checklist updates on
// its own instead of needing a separate "check again" button.
function Window_OnFocus() {
    if (!isRunning && !isChecking) CheckRequirements();
}
</script>
</head>
<body onload="Window_OnLoad()" onfocus="Window_OnFocus()">

<div class="topbar clearfix">
    <span class="brand-mark">RH</span>
    <span class="brand-name">RoyalHub Standalone</span>
    <div class="conn-badge">
        <span class="conn-dot" id="connDot"></span>
        <span id="connText">Checking</span>
    </div>
</div>

<p class="lead">Checks for updates automatically, then click Run to start the app. It opens in your browser.</p>

<div class="card">
    <div class="status-row clearfix">
        <span class="status-icon" id="icon-node">&#8230;</span>
        <span class="status-text" id="text-node"><span class="label">Node.js</span> <span class="detail">Checking this computer&#8230;</span></span>
    </div>
    <div class="status-row bordered clearfix">
        <span class="status-icon" id="icon-update">&#8230;</span>
        <span class="status-text" id="text-update"><span class="label">Version</span> <span class="detail">Checking for updates&#8230;</span></span>
    </div>
</div>

<div class="actions-primary">
    <button id="runBtn" class="btn btn-primary btn-block" onclick="RunApp()" disabled>Run</button>
    <button id="stopBtn" class="btn btn-danger btn-block" onclick="StopApp()" style="display:none">Stop</button>
</div>
<button id="openBtn" class="btn btn-ghost btn-block" onclick="OpenInBrowser()" style="display:none">Open in Browser</button>

<div class="divider"></div>

<div class="actions-secondary clearfix">
    <button id="backupBtn" class="btn btn-outline" onclick="BackupData()">Back Up Data</button>
    <button id="restoreBtn" class="btn btn-outline right" onclick="RestoreData()">Restore Data</button>
</div>

<div id="status"></div>
</body>
</html>
