# Copy this file to .env.migration and fill in the values, then run:
#   npm run migrate:from-cloud
#
# These are PRODUCTION credentials for the cloud/Azure edition — only needed
# once, to pull real data into this standalone edition. This file itself
# (.env.migration) is gitignored; never commit real credentials.

# Postgres connection string for the production database.
# Cloud repo's own .env.local / App Service configuration has this value.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Azure Blob Storage connection string for the production storage account.
# Azure Portal -> Storage account -> Access keys -> Connection string.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# The EXACT SAME compensation encryption key production uses right now.
# Cloud repo's own .env.local / App Service configuration has this value.
# Getting this wrong means every compensation figure becomes permanently
# unreadable after migration — double-check it matches production exactly.
COMPENSATION_ENCRYPTION_KEY=paste-productions-real-key-here
